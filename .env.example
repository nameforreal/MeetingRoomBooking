# Templates only. Generate unique values before deployment. Do not commit .env.
DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,booking.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://booking.example.org
DB_ENGINE=postgres
POSTGRES_DB=meetingroom
POSTGRES_USER=meetingroom
POSTGRES_PASSWORD=
# Windows venv defaults; Compose supplies its own internal db hostname.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Leave empty for venv without Redis. Compose sets redis://redis:6379/0.
REDIS_URL=
# Optional private scrape token. Empty disables /metrics/.
METRICS_TOKEN=
DJANGO_TRUST_PROXY=False
# Local HTTP Compose requires compose.local.yaml; production uses compose.production.yaml.
HTTP_PORT=8080
HTTPS_PORT=8443
HTTPS_BIND=127.0.0.1
LOCAL_POSTGRES_PORT=55440
