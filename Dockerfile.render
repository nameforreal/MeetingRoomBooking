# syntax=docker/dockerfile:1
FROM python:3.14.2-slim-bookworm AS dependencies
WORKDIR /build
COPY requirements.txt .
RUN pip wheel --only-binary=:all: --wheel-dir=/wheels -r requirements.txt

FROM python:3.14.2-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app DJANGO_READ_DOT_ENV=false DJANGO_SETTINGS_MODULE=config.settings_render
WORKDIR /app
COPY --from=dependencies /wheels /wheels
COPY requirements.txt .
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r requirements.txt \
    && rm -rf /wheels \
    && test -s /etc/ssl/certs/ca-certificates.crt \
    && groupadd --gid 10001 app && useradd --uid 10001 --gid app --no-create-home app \
    && mkdir /app/staticfiles && chown app:app /app/staticfiles
COPY manage.py .
COPY config ./config
COPY rooms ./rooms
COPY management ./management
COPY dashboard ./dashboard
COPY docker/render_entrypoint.py docker/render_gunicorn.py docker/entrypoint.py docker/gunicorn.conf.py docker/healthcheck.py ./docker/
USER 10001:10001
EXPOSE 10000
ENTRYPOINT ["python", "docker/render_entrypoint.py"]
